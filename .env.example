# Copy to .env and fill in the real value. .env is gitignored.
#   Copy-Item .env.example .env   (PowerShell)
#
# Create your key at: https://connect.garmin.com/app/settings/personalApiToken
# Garmin shows it exactly once. Expires after 30/90/180/365 days (your choice).
# Paste it in with an editor -- not via `$env:...=` or `echo`, which PowerShell
# logs to %APPDATA%\Microsoft\Windows\PowerShell\PSReadline\ConsoleHost_history.txt

GARMIN_PERSONAL_API_KEY=your-personal-api-key-here
